<Window x:Class="GeZi.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource String.AboutWindow.Window.Title.921c1a06}"
        Width="430"
        SizeToContent="Height"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        「关于」窗口（2026-10-03 新增，用户要求「和 Python Flet 版那个差不多」）。
        ⚠️ 跟主窗/小窗一样走 WindowChrome（不是分层窗口 → ClearType 正常、文字清晰），
           圆角交给 DWM（见 Loaded 里的 ApplyRoundedCorners）。
        ⚠️ CaptionHeight=44 让标题栏能拖动，里面的关闭按钮要 IsHitTestVisibleInChrome。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
        <StackPanel>
            <!-- 标题栏 -->
            <Grid Height="44" Background="Transparent">
                <TextBlock Text="{DynamicResource String.AboutWindow.TextBlock.Text.921c1a06}" Margin="18,0,44,0"
                           VerticalAlignment="Center"
                           FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button x:Name="CloseBtn" Click="OnCloseClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="{DynamicResource String.AboutWindow.CloseBtn.AutomationName.6c14bd7f}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Width="30" Height="30"
                        Style="{StaticResource CaptionCloseButton}" ToolTip="{DynamicResource String.AboutWindow.CloseBtn.ToolTip.6c14bd7f}">
                    <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="11" Height="11"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,0,18,18">

                    <!-- 品牌行：图标 + 名称 / 版本 / 一句话 -->
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/app-logo.png" Width="56" Height="56"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource String.AboutWindow.TextBlock.Text.4fb2ed08}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="VersionText" Text="{DynamicResource String.AboutWindow.VersionText.Text.6d569ef0}"
                                       FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{DynamicResource String.AboutWindow.TextBlock.Text.1e27d0ed}"
                                       FontSize="11" Margin="0,1,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 作者 B 站（点击跳转） -->
                    <Button x:Name="BiliBtn" Click="OnBiliClick"
                            AutomationProperties.Name="{DynamicResource String.AboutWindow.BiliBtn.AutomationName.5f879d0f}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Padding="0">
                        <TextBlock x:Name="BiliText" Text="{DynamicResource String.AboutWindow.BiliText.Text.2b961600}"
                                   FontSize="11.5" TextDecorations="Underline"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Button>

                    <!-- 应用简介 -->
                    <TextBlock Text="{DynamicResource String.AboutWindow.TextBlock.Text.9b586081}" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                    <TextBlock Style="{StaticResource ProseText}" TextWrapping="Wrap"
                               Text="{DynamicResource String.AboutWindow.TextBlock.Text.99668a92}"/>

                    <!-- 功能特性 -->
                    <TextBlock Text="{DynamicResource String.AboutWindow.TextBlock.Text.334a837a}" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
                    <StackPanel x:Name="FeatureList"/>

                    <!-- 赞赏支持 -->
                    <TextBlock Text="{DynamicResource String.AboutWindow.TextBlock.Text.8086ec0a}" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- ⚠️ 用真 Button 而不是 Border+MouseLeftButtonUp：
                             Border 没有 automation peer，**UIA 树里根本找不到它**（点不到、也测不了）；
                             Button 有 InvokePattern，键盘 Tab+回车 也能用。 -->
                        <Button x:Name="QrBtn" Click="OnQrClick"
                                Style="{StaticResource IconGhostButton}"
                                Width="Auto" Height="Auto" Padding="0"
                                AutomationProperties.Name="{DynamicResource String.AboutWindow.QrBtn.AutomationName.fe92ee1b}"
                                ToolTip="{DynamicResource String.AboutWindow.QrBtn.ToolTip.c00971f7}">
                            <Border BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="8" Padding="6"
                                    Background="{DynamicResource SurfaceBrush}">
                                <Image Source="/Resources/reward-qr.png" Width="150" Height="150"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Button>
                        <TextBlock Text="{DynamicResource String.AboutWindow.TextBlock.Text.1fffbc74}"
                                   FontSize="10.5" Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Text="{DynamicResource String.AboutWindow.TextBlock.Text.8e20eede}" FontSize="12.5" FontWeight="SemiBold"
                                   Margin="0,3,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- 底部 -->
                    <Button x:Name="OkBtn" Content="{DynamicResource String.AboutWindow.OkBtn.Content.6c14bd7f}" Click="OnCloseClick"
                            AutomationProperties.Name="{DynamicResource String.AboutWindow.OkBtn.AutomationName.6c14bd7f}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" MinWidth="96" Margin="0,18,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
